#!/bin/bash
set -e

install_on_fedora() {
  sudo dnf install -y ansible
}

install_on_ubuntu() {
  sudo apt-get update
  sudo apt-get install -y ansible
}

install_on_pacman() {
  sudo pacman -S --noconfirm --needed ansible
}

install_on_mac() {
  brew install ansible
}

OS="$(uname -s)"
case "${OS}" in
Linux*)
  # shellcheck source=/dev/null
  . /etc/os-release
  # Match on the distro itself and what it is based on, e.g.
  # CachyOS: ID=cachyos ID_LIKE=arch; Ubuntu: ID=ubuntu ID_LIKE=debian
  case " ${ID} ${ID_LIKE:-} " in
  *" arch "*)
    install_on_pacman
    ;;
  *" fedora "*)
    echo "Unsupported Linux distribution ${ID}"
    exit 1
    # to re-enable: install_on_fedora
    ;;
  *" debian "* | *" ubuntu "*)
    echo "Unsupported Linux distribution ${ID}"
    exit 1
    # to re-enable: install_on_ubuntu
    ;;
  *)
    echo "Unsupported Linux distribution ${ID}"
    exit 1
    ;;
  esac
  ;;
Darwin*)
  echo "Unsupported operating system: ${OS}"
  exit 1
  # to re-enable install_on_mac
  ;;
*)
  echo "Unsupported operating system: ${OS}"
  exit 1
  ;;
esac

echo "Starting Ansible setup"

ansible-galaxy collection install -r ~/.bootstrap/requirements.yml
cd ~/.bootstrap && ansible-playbook setup.yml --ask-become-pass

echo "Ansible installation complete."

if [ ! -f ~/.ssh/GitHub ]; then
  ssh-keygen -t ed25519 -f ~/.ssh/GitHub -C "{{ .email }}"
  echo "Add this key to GitHub: https://github.com/settings/keys"
  cat ~/.ssh/GitHub.pub
fi
