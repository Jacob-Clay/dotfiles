{{- /* chezmoi:template:left-delimiter=[[ right-delimiter=]] */ -}}
---
- name: Ensure chromium extensions directory exists
  ansible.builtin.file:
    path: /usr/share/chromium/extensions
    state: directory
    mode: '0755'
  become: true

- name: Install Brave extension JSON files
  ansible.builtin.copy:
    content: |
      {
        "external_update_url": "https://clients2.google.com/service/update2/crx"
      }
    dest: "/usr/share/chromium/extensions/{{ item }}.json"
    mode: '0644'
  become: true
  loop:
    - gebbhagfogifgggkldgodflihgfeippi  # Return YouTube Dislike
    - mnjggcdmjocbbbhaepdhchncahnbgone  # SponsorBlock for YouTube
    - dhdgffkkebhmkfjojejmpbldmpobfkfo  # Tampermonkey
    - aejbmaihhlajphnlcdbojkjbdckkfdki  # Video Speed Control
    - bkkmolkhemgaeaeggcmfbghljjjoofoh  # Catppuccin Mocha theme
    - oboonakemofpalcgghocfoadofidjkkk  # KeePassXC-Browser
[[ if eq .desktop "kde" ]]
    - cimiefiiaegbelhefglklhhakcgmhkai  # Plasma Integration
[[ end ]]

- name: Enable and start syncthing
  ansible.builtin.systemd:
    name: "syncthing@{{ remote_regular_user }}"
    enabled: true
    state: started
  become: true

- name: Enable and start tailscale
  ansible.builtin.systemd:
    name: tailscaled
    enabled: true
    state: started
  become: true

[[ if eq .desktop "niri" ]]
# ------------ Noctalia Greeter (greetd) --------------------
# https://docs.noctalia.dev/greeter/installation/
- name: Point greetd at the Noctalia greeter
  community.general.ini_file:
    path: /etc/greetd/config.toml
    section: default_session
    option: "{{ item.option }}"
    value: "{{ item.value }}"
    mode: '0644'
  loop:
    - { option: command, value: '"/usr/bin/noctalia-greeter-session"' }
    - { option: user, value: '"greeter"' }
  become: true

- name: Create Noctalia greeter state directory
  ansible.builtin.command:
    cmd: systemd-tmpfiles --create noctalia-greeter.conf
    creates: /var/lib/noctalia-greeter
  become: true

- name: Initialise Noctalia greeter config (greeter.toml / sync.toml)
  ansible.builtin.command:
    cmd: noctalia-greeter-apply-appearance --setup-system
    creates: /var/lib/noctalia-greeter/greeter.toml
  become: true

- name: Allow syncing shell appearance to the greeter without a password prompt
  ansible.builtin.command:
    cmd: "noctalia-greeter passwordless-sync enable {{ remote_regular_user }}"
  register: greeter_passwordless
  changed_when: "'already enabled' not in greeter_passwordless.stdout"
  become: true

- name: Enable AccountsService (login screen avatars)
  ansible.builtin.systemd:
    name: accounts-daemon
    enabled: true
  become: true

- name: Find the currently enabled display manager
  ansible.builtin.command:
    cmd: readlink -f /etc/systemd/system/display-manager.service
  register: current_dm
  changed_when: false
  failed_when: false

- name: Disable any other display manager
  ansible.builtin.systemd:
    name: "{{ current_dm.stdout | basename }}"
    enabled: false
  when:
    - current_dm.rc == 0
    - (current_dm.stdout | basename) != "greetd.service"
  become: true

- name: Unlock GNOME Keyring at greeter login (PAM)
  ansible.builtin.lineinfile:
    path: /etc/pam.d/greetd
    line: "{{ item.line }}"
    insertafter: "{{ item.after }}"
  loop:
    - { line: "auth       optional     pam_gnome_keyring.so", after: '^auth' }
    - { line: "session    optional     pam_gnome_keyring.so auto_start", after: '^session' }
  become: true

# Enabled only, not started: starting it now would grab the VT from a running
# session. It takes over on the next boot.
- name: Enable greetd
  ansible.builtin.systemd:
    name: greetd
    enabled: true
  become: true
[[ end ]]


- name: Check whether Syncthing is paired with any other device
  ansible.builtin.command:
    cmd: syncthing cli config devices list
  become: false
  register: syncthing_devices
  changed_when: false
  failed_when: false

- name: Decide whether Syncthing still needs setup
  ansible.builtin.set_fact:
    syncthing_needs_setup: "{{ syncthing_devices.rc != 0 or (syncthing_devices.stdout_lines | length) < 2 }}"

- name: Wait for the Syncthing web UI
  ansible.builtin.wait_for:
    port: 8384
    timeout: 60
  when: syncthing_needs_setup

- name: Open Syncthing UI in Brave
  ansible.builtin.command:
    cmd: brave-origin-beta http://localhost:8384
  become: false
  when: syncthing_needs_setup

- name: Wait for user to finish Syncthing setup
  ansible.builtin.pause:
    prompt: "Complete Syncthing setup in the browser, then press enter to continue"
  when: syncthing_needs_setup

- name: Check Tailscale status
  ansible.builtin.command:
    cmd: tailscale status
  become: false
  register: tailscale_status
  ignore_errors: true

- name: Manual Tailscale login required
  ansible.builtin.pause:
    prompt: "Tailscale is not logged in. Please run 'sudo tailscale up' in another terminal,\n
complete the login, then press enter to continue"
  when: tailscale_status.rc != 0

[[ if .is_hp_envy ]]
- name: install needed dependency for hda-verb
  community.general.pacman:
    name: "alsa-tools"
    state: present
  when: ansible_facts['os_family'] == "Archlinux"

- name: Add hda-verb sudoers rule
  ansible.builtin.lineinfile:
    path: /etc/sudoers.d/hda-verb
    line: "{{ remote_regular_user }} ALL=(ALL) NOPASSWD: /usr/bin/hda-verb *"
    create: yes
    mode: '0440'
    validate: 'visudo -cf %s'

- name: Enable linger for user
  ansible.builtin.command:
    cmd: loginctl enable-linger {{ remote_regular_user }}
  changed_when: false

- name: Get user info
  ansible.builtin.getent:
    database: passwd
    key: "{{ remote_regular_user }}" 

- name: Reload systemd user daemon and enable services
  ansible.builtin.systemd:
    name: "{{ item }}"
    enabled: yes
    state: started
    scope: user
    daemon_reload: yes
  loop:
    - audio-led.service
    - mic-led.service
  become: yes
  become_user: "{{ remote_regular_user }}"
  environment:
    XDG_RUNTIME_DIR: "/run/user/{{ ansible_facts['getent_passwd'][remote_regular_user][2] }}"
[[ end ]]
